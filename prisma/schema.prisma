generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Settings {
  id                  Int       @id @default(1)
  startDate           String    @default("") @map("start_date")
  heroImage           String    @map("hero_image")
  customCovers        String    @map("custom_covers")
  hiddenDefaultCovers String    @map("hidden_default_covers")
  countdowns          String
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

model Event {
  id          String   @id
  title       String
  date        String
  description String
  icon        String   @default("heart")
  location    String   @default("")
  mood        String   @default("")
  coverPhoto  String   @default("") @map("cover_photo")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  photos   Photo[]
  expenses Expense[]

  @@map("events")
}

model Photo {
  id         Int      @id @default(autoincrement())
  url        String   @unique
  displayUrl String   @map("display_url")
  thumbUrl   String   @map("thumb_url")
  filename   String   @default("")
  mimeType   String   @default("") @map("mime_type")
  fileSize   Int      @default(0) @map("file_size")
  sortOrder  Int      @default(0) @map("sort_order")
  uploadedAt String   @map("uploaded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  eventId String? @map("event_id")
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@map("photos")
}

model Expense {
  id        Int      @id @default(autoincrement())
  eventId   String   @map("event_id")
  amount    Float
  category  String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model LoveQuote {
  id        Int      @id @default(autoincrement())
  content   String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("love_quotes")
}

model Wish {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  emoji       String   @default("💝")
  isCompleted Boolean  @default(false) @map("is_completed")
  completedAt String?  @map("completed_at")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("wishes")
}

model Capsule {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  emoji      String   @default("💌")
  unlockDate String   @map("unlock_date")
  isOpened   Boolean  @default(false) @map("is_opened")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("capsules")
}
