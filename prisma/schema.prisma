generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Settings {
  id           Int      @id @db.TinyInt
  startDate    String   @default("") @map("start_date") @db.VarChar(20)
  heroImage    String   @map("hero_image") @db.LongText
  customCovers      String   @map("custom_covers") @db.LongText
  hiddenDefaultCovers String   @map("hidden_default_covers") @db.LongText
  countdowns        String   @db.LongText
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

model Event {
  id          String   @id @db.VarChar(64)
  title       String   @db.VarChar(255)
  date        String   @db.VarChar(20)
  description String   @db.Text
  icon        String   @default("heart") @db.VarChar(64)
  location    String   @default("") @db.VarChar(500)
  mood        String   @default("") @db.VarChar(100)
  coverPhoto  String   @default("") @map("cover_photo") @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order") @db.Int
  createdAt   DateTime @default(now()) @map("created_at")

  photos   Photo[]
  expenses Expense[]

  @@map("events")
}

model Photo {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  url        String   @db.VarChar(500)
  displayUrl String   @map("display_url") @db.Text
  thumbUrl   String   @map("thumb_url") @db.Text
  filename   String   @default("") @db.VarChar(255)
  mimeType   String   @default("") @map("mime_type") @db.VarChar(100)
  fileSize   Int      @default(0) @map("file_size") @db.UnsignedInt
  sortOrder  Int      @default(0) @map("sort_order") @db.Int
  uploadedAt String   @map("uploaded_at") @db.VarChar(40)
  createdAt  DateTime @default(now()) @map("created_at")

  eventId String? @map("event_id") @db.VarChar(64)
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([url], map: "photos_url_unique")
  @@map("photos")
}

model Expense {
  id        Int      @id @default(autoincrement())
  eventId   String   @map("event_id") @db.VarChar(64)
  amount    Float    @db.Double
  category  String   @default("") @db.VarChar(100)
  note      String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model LoveQuote {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  sortOrder Int      @default(0) @map("sort_order") @db.Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("love_quotes")
}

model Wish {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String   @default("") @db.VarChar(1000)
  emoji       String   @default("💝") @db.VarChar(10)
  isCompleted Boolean  @default(false) @map("is_completed")
  completedAt String?  @map("completed_at") @db.VarChar(40)
  sortOrder   Int      @default(0) @map("sort_order") @db.Int
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("wishes")
}

model Capsule {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(255)
  content    String   @db.Text
  emoji      String   @default("💌") @db.VarChar(10)
  unlockDate String   @map("unlock_date") @db.VarChar(20)
  isOpened   Boolean  @default(false) @map("is_opened")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("capsules")
}
